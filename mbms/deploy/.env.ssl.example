# Copy to .env.ssl (gitignored — real domains/email are host-specific, and
# .env.ssl sits next to the issued certificates) and fill in real values
# before running ./init-letsencrypt.sh.
#
# These must be real, publicly resolvable domain names: Let's Encrypt
# validates ownership over the internet (the HTTP-01 challenge on port
# 80), so localhost / internal hostnames will not work, and DNS for all
# three must already point at this host's public IP before the script
# runs.

ADMIN_DOMAIN=admin.moriseholdings.example
STOREFRONT_DOMAIN=shop.moriseholdings.example
API_DOMAIN=api.moriseholdings.example

# Let's Encrypt sends expiry-warning mail here and requires it for
# --agree-tos; use a real, monitored address.
LETSENCRYPT_EMAIL=admin@moriseholdings.example

# Set to 1 while first testing this setup, to use Let's Encrypt's staging
# endpoint (untrusted certs, but no rate limit) instead of production — the
# production endpoint allows only 5 duplicate-certificate requests per
# domain per week, easy to exhaust while debugging DNS/nginx issues.
STAGING=0
