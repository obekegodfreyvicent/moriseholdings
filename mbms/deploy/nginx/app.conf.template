# Public-facing reverse proxy + TLS termination for a self-hosted / VPS
# deployment of the MBMS stack (Admin app, Customer Storefront, backend
# API). Certificates are issued and renewed by Let's Encrypt via
# mbms/deploy/init-letsencrypt.sh and the certbot service in
# docker-compose.ssl.yml. Domain names come from mbms/deploy/.env.ssl (see
# .env.ssl.example) and are substituted into this file at container start
# by the nginx-proxy service's `command` — do not hardcode real domains
# here.
#
# This container is the only thing in the stack that terminates TLS. It
# proxies to the existing internal, plain-HTTP containers (frontend:80,
# storefront:80, backend:3001) over the docker-compose network — those
# containers' own nginx.conf / Dockerfiles are unchanged by this file.

# ACME HTTP-01 challenge for all three domains, then redirect everything
# else to HTTPS.
server {
    listen 80;
    server_name ${ADMIN_DOMAIN} ${STOREFRONT_DOMAIN} ${API_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${ADMIN_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${ADMIN_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${ADMIN_DOMAIN}/privkey.pem;
    include /etc/nginx/ssl-params.conf;

    location / {
        proxy_pass http://frontend:80;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${STOREFRONT_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${STOREFRONT_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${STOREFRONT_DOMAIN}/privkey.pem;
    include /etc/nginx/ssl-params.conf;

    location / {
        proxy_pass http://storefront:80;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${API_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${API_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${API_DOMAIN}/privkey.pem;
    include /etc/nginx/ssl-params.conf;

    location / {
        proxy_pass http://backend:3001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
